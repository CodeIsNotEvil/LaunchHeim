<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that does not need Qt: instances, the mod installer, the mod site clients and the game
    launcher. Keeping Qt out of here means the logic is unit-testable without a display, and the UI
    layer could be swapped if Qml.Net (unmaintained, Qt 5 only) ever becomes a dead end.
  -->

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source RCON, shared with the server plugin so both ends of the protocol stay in step (decision 0020). -->
    <Compile Include="..\Shared\SourceRcon.cs" Link="Servers\SourceRcon.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LaunchHeim.Core.Tests" />
  </ItemGroup>

</Project>
